# FinOnto 配置示例：cp server/.env.example server/.env
#
# 优先级：var/components.json（组件中心写入） > 进程环境变量 > .env > 代码默认值
# 所有键名 = FINONTO_ + Settings 字段名的大写（见 server/app/config.py）

# ---------------------------------------------------------------- 应用
FINONTO_APP_NAME=FinOnto
FINONTO_ENV=local
# 数据目录（SQLite / 对象存储 / 上传件 / 沙箱），默认 server/var
# FINONTO_DATA_DIR=D:/data/finonto
# 留空则用 sqlite:///<data_dir>/finonto.db
# FINONTO_DATABASE_URL=postgresql+psycopg://user:pass@127.0.0.1:5432/finonto
# 必须是 JSON 数组，逗号分隔会启动报错
FINONTO_CORS_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000"]
FINONTO_AUTO_BOOTSTRAP=true
FINONTO_MAX_UPLOAD_MB=25

# ---------------------------------------------------------------- 企业落地：认证 / 授权 / 审计
# 生产必须为 true；false 时所有请求按管理员处理（仅用于本机演示/离线验证）
FINONTO_AUTH_ENABLED=true
# 初始管理员（仅在没有用户时创建一次）；登录后强制改密
FINONTO_ADMIN_USERNAME=admin
FINONTO_ADMIN_PASSWORD=admin123
# 会话有效期（小时）
FINONTO_SESSION_TTL_HOURS=12
# 登录防爆破：连续失败次数与锁定分钟数
FINONTO_AUTH_LOGIN_MAX_ATTEMPTS=5
FINONTO_AUTH_LOCK_MINUTES=15
# HTTPS 部署时置 true（Cookie 加 Secure）
FINONTO_COOKIE_SECURE=false
# 昂贵接口（/api/rag/*、/api/agent/*）每用户每分钟配额
FINONTO_RATE_LIMIT_PER_MIN=120
# 审计日志保留天数
FINONTO_AUDIT_RETENTION_DAYS=180

# ---------------------------------------------------------------- 对话模型
# mock = 本地抽取式（零密钥，可完整跑通）；其余为 OpenAI 兼容
# 可选：openai_compat:dashscope|openai|deepseek|moonshot|zhipu|volcengine|vllm|ollama
FINONTO_LLM_PROVIDER=mock
FINONTO_LLM_BASE_URL=
FINONTO_LLM_API_KEY=
FINONTO_LLM_MODEL=
FINONTO_LLM_TEMPERATURE=0.2

# ---------------------------------------------------------------- 向量化
# local_hash（384 维，零依赖）| openai_compat
FINONTO_EMBEDDING_PROVIDER=local_hash
FINONTO_EMBEDDING_BASE_URL=
FINONTO_EMBEDDING_API_KEY=
FINONTO_EMBEDDING_MODEL=
FINONTO_EMBEDDING_DIM=384

# ---------------------------------------------------------------- 存储
# sqlite_numpy | memory | pgvector
FINONTO_VECTOR_STORE=sqlite_numpy
# local_fs | s3
FINONTO_OBJECT_STORE=local_fs
FINONTO_OBJECT_STORE_BUCKET=finonto
FINONTO_OBJECT_STORE_ENDPOINT=
FINONTO_OBJECT_STORE_KEY=
FINONTO_OBJECT_STORE_SECRET=

# ---------------------------------------------------------------- 解析 / 数据源
FINONTO_DOC_PARSER=default_multi_format
FINONTO_DATA_SOURCE=auto

# ---------------------------------------------------------------- 网搜 / IM / 重排
# none | duckduckgo | tavily | bocha | serper
FINONTO_WEB_SEARCH=none
FINONTO_WEB_SEARCH_API_KEY=
# none | dingtalk | feishu | wecom | slack
FINONTO_IM_CHANNEL=none
FINONTO_IM_WEBHOOK=
# heuristic | llm | cross_encoder
FINONTO_RERANK_PROVIDER=heuristic

# ---------------------------------------------------------------- 检索 / Agent
FINONTO_CHUNK_SIZE=420
FINONTO_CHUNK_OVERLAP=60
FINONTO_RETRIEVE_TOP_K=8
FINONTO_AGENT_MAX_STEPS=8
FINONTO_AGENT_STEP_TOKEN_BUDGET=1800
FINONTO_SANDBOX_ENABLED=true
FINONTO_SANDBOX_TIMEOUT_S=6

# ---------------------------------------------------------------- 部署
# local | docker | k8s | serverless | edge
FINONTO_DEPLOY_TARGET=local
FINONTO_WIKI_COMPILE_ON_ACCEPT=true
