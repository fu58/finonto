# FinOnto 运行配置模板：复制为 server/.env 后按需修改。
# 全部留空/保持默认时，系统使用本地可跑实现（Mock LLM + 特征哈希 Embedding +
# SQLite 向量库 + 本地文件对象存储），不需要任何外部 API 密钥即可跑通主流程。

# --- 基础 -----------------------------------------------------------------
FINONTO_APP_NAME=FinOnto
# 数据目录（SQLite、对象存储、上传件、沙箱工作区都放在这里）
#FINONTO_DATA_DIR=./var
# 留空则使用 sqlite:///<DATA_DIR>/finonto.db
#FINONTO_DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5432/finonto
# 冷启动（本体基线 + 示例语料 + 首次 Wiki 编译）开关
FINONTO_AUTO_BOOTSTRAP=true
# 跨域白名单是列表，必须写成 JSON 数组（逗号分隔会让服务启动失败）
#FINONTO_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- 模型厂商（llm）-------------------------------------------------------
# mock | openai_compat:dashscope | openai_compat:openai | openai_compat:deepseek |
# openai_compat:moonshot | openai_compat:zhipu | openai_compat:volc |
# openai_compat:vllm | openai_compat:ollama
FINONTO_LLM_PROVIDER=mock
FINONTO_LLM_MODEL=qwen-plus
FINONTO_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
FINONTO_LLM_API_KEY=
FINONTO_LLM_TEMPERATURE=0.2
FINONTO_LLM_MAX_TOKENS=2048
FINONTO_LLM_TIMEOUT_S=120

# --- Embedding ------------------------------------------------------------
# local_hash（免密钥）| openai_compat
FINONTO_EMBEDDING_PROVIDER=local_hash
FINONTO_EMBEDDING_MODEL=text-embedding-v3
FINONTO_EMBEDDING_BASE_URL=
FINONTO_EMBEDDING_API_KEY=
# 切换实现后请重建索引（文档页「重建索引」或 scripts/smoke.py），维度不同的向量不能混用
FINONTO_EMBEDDING_DIM=384

# --- 向量数据库 -----------------------------------------------------------
# sqlite_numpy（默认，免依赖）| pgvector | dashvector | memory
FINONTO_VECTOR_STORE=sqlite_numpy
# pgvector 复用 FINONTO_DATABASE_URL；DashVector 需要密钥与集合名时用同名环境变量

# --- 对象存储 -------------------------------------------------------------
# local_fs（默认）| oss
FINONTO_OBJECT_STORE=local_fs
FINONTO_OSS_BUCKET=
FINONTO_OSS_ENDPOINT=
FINONTO_OSS_ACCESS_KEY_ID=
FINONTO_OSS_ACCESS_KEY_SECRET=

# --- 网络搜索 -------------------------------------------------------------
# none（默认）| duckduckgo | tavily | bocha | serper
FINONTO_WEB_SEARCH_PROVIDER=none
FINONTO_WEB_SEARCH_API_KEY=
FINONTO_WEB_SEARCH_ENDPOINT=

# --- IM 通知渠道 ----------------------------------------------------------
# none（默认，打印到服务日志）| dingtalk | feishu | wecom | slack
FINONTO_IM_CHANNEL=none
FINONTO_IM_WEBHOOK_URL=
FINONTO_IM_SECRET=

# --- 沙箱（Agent 代码执行）------------------------------------------------
FINONTO_SANDBOX_ENABLED=true
FINONTO_SANDBOX_TIMEOUT_S=10
FINONTO_SANDBOX_MAX_OUTPUT=20000

# --- Agent 推理预算 -------------------------------------------------------
FINONTO_AGENT_MAX_STEPS=12
FINONTO_AGENT_STEP_TOKEN_BUDGET=1500

# --- RAG 检索链路 ---------------------------------------------------------
FINONTO_RAG_TOP_K_BM25=40
FINONTO_RAG_TOP_K_DENSE=40
# rrf | weighted
FINONTO_RAG_FUSION=rrf
FINONTO_RAG_CANDIDATE_K=24
FINONTO_RAG_FINAL_K=8
FINONTO_RAG_MMR_LAMBDA=0.35
# heuristic（默认）| llm | cross_encoder
FINONTO_RERANK_PROVIDER=heuristic

# --- 分块 -----------------------------------------------------------------
FINONTO_CHUNK_MAX_TOKENS=420
FINONTO_CHUNK_OVERLAP_TOKENS=60
